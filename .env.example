# =============================================================================
# سامانه مدیریت مدرسه — نمونه تنظیمات محیط
#
# این فایل را به `.env` کپی کنید و مقادیر را تغییر دهید:
#     cp .env.example .env
#
# `.env` در .gitignore است و هرگز نباید در مخزن قرار بگیرد.
# هر مقدار پیش‌فرضی که اینجا نوشته شده، همان پیش‌فرض کد در settings.py است.
# =============================================================================

# ---- عمومی ------------------------------------------------------------------
# در عملیات حتماً یک کلید تصادفی ۵۰ کاراکتری بگذارید:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-in-production

# True فقط برای توسعه. با True صفحه خطا کل تنظیمات را به کاربر نشان می‌دهد.
DJANGO_DEBUG=True

# دامنه‌هایی که سرویس به آن‌ها پاسخ می‌دهد — با کاما جدا، بدون پروتکل.
# در عملیات فهرست صریح بدهید؛ `*` یعنی حمله Host Header باز است.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# مبدأهای مورد اعتماد برای فرم و POST (پنل مدیریت پشت HTTPS) — با پروتکل.
# مثال عملیاتی: https://panel.example.school,https://example.school
CSRF_TRUSTED_ORIGINS=

# مسیر پنل مدیریت. تغییرش در عملیات، پنل را از دید اسکنرهای خودکار خارج می‌کند.
ADMIN_URL=admin/

# سطح لاگ: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# ---- زبان و زمان -------------------------------------------------------------
DJANGO_LANGUAGE_CODE=fa
DJANGO_TIME_ZONE=Asia/Tehran

# ---- پایگاه داده -------------------------------------------------------------
# پیش‌فرض SQLite در پوشه `database/`. برای PostgreSQL این را پر کنید:
# DATABASE_URL=postgres://user:pass@localhost:5432/school
DATABASE_URL=

# نام فایل SQLite داخل پوشه database/
SQLITE_NAME=db.sqlite3

# جابه‌جایی خودِ پوشه‌ها (مسیر مطلق). خالی = پیش‌فرض کنار پروژه.
# DATABASE_DIR=/var/lib/school/database
# PUBLIC_DIR=/var/www/school/public

# ---- فایل‌های ثابت و آپلودی ---------------------------------------------------
# نکته مهم: این‌ها «نشانی وب» هستند، نه مسیر روی دیسک. فایل‌ها همیشه در
# backend/public/static و backend/public/media ذخیره می‌شوند؛ این دو متغیر فقط
# تعیین می‌کنند مرورگر با چه نشانی‌ای آن‌ها را صدا بزند. وب‌سرور این نشانی را
# به مسیر دیسک نگاشت می‌کند.
#
# مقدار را با پیکربندی وب‌سرورتان هماهنگ کنید:
#
#   الف) اگر nginx بلوک `location /static/` با alias به public/static دارد:
#        STATIC_URL=static/
#
#   ب) اگر nginx کل پوشه `public/` را سرو می‌کند (یعنی نشانی‌های واقعی
#      /public/static/... هستند):
#        STATIC_URL=public/static/
#        MEDIA_URL=public/media/
#
# ناهماهنگی این دو یعنی پنل مدیریت بی‌استایل و Swagger/ReDoc صفحه سفید.
STATIC_URL=static/
MEDIA_URL=media/

# سقف حجمی که هنگام آپلود در حافظه نگه داشته می‌شود (بایت) — پیش‌فرض ۱۰ مگابایت.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760

# ---- JWT ---------------------------------------------------------------------
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- CORS --------------------------------------------------------------------
# مبدأهای فرانت‌اند — با پروتکل و پورت، جداشده با کاما.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# اگر فرانت با کوکی کار می‌کند (نه فقط توکن) این را True کنید.
CORS_ALLOW_CREDENTIALS=False

# فقط توسعه. True یعنی CORS عملاً خاموش است.
CORS_ALLOW_ALL_ORIGINS=False

# ---- امنیت -------------------------------------------------------------------
# این‌ها با DJANGO_DEBUG=False خودکار روشن می‌شوند؛ فقط برای حالت‌های خاص
# دستی تنظیم‌شان کنید.

# پشت nginx/traefik که خودش TLS را تمام می‌کند این را True کنید، وگرنه
# SECURE_SSL_REDIRECT حلقه ریدایرکت می‌سازد.
USE_X_FORWARDED_PROTO=False

# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
